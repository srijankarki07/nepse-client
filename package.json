{
  "name": "@srijankarki44/nepse-data",
  "version": "0.1.0",
  "description": "Read NEPSE end-of-day prices from a maintained public archive — no API key, no scraping, no server",
  "type": "module",
  "license": "MIT",
  "author": "Srijan Karki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srijankarki07/nepse-client.git"
  },
  "homepage": "https://github.com/srijankarki07/nepse-client#readme",
  "bugs": "https://github.com/srijankarki07/nepse-client/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "nepse",
    "nepal",
    "nepal-stock-exchange",
    "stock",
    "market",
    "prices",
    "eod",
    "end-of-day",
    "finance"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE=1 vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
